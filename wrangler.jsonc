{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "cms-test",
	"main": "./src/worker.ts",
	"compatibility_date": "2026-02-24",
	"compatibility_flags": ["nodejs_compat"],
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "cms-test","database_id": "d43de523-9a19-49cb-b1b6-1617f4f2a622",
		},
	],
	"r2_buckets": [
		{
			"binding": "MEDIA",
			"bucket_name": "cms-test-media","preview_bucket_name": "cms-test-media",
		},
	],
	// Sandboxed plugins require Worker Loader, available on Workers paid plans. Uncomment to enable:
	// "worker_loaders": [{ "binding": "LOADER" }],
	// General maintenance cron trigger
	"triggers": {
		"crons": ["* * * * *"],
	},
}
